# NetAssist VS Code Extension - Git Ignore

# VS Code Extension specific
out/
dist/
*.vsix
.vscode-test/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (sanitization server)
sanitization-server/venv/
sanitization-server/__pycache__/
sanitization-server/*.pyc
sanitization-server/.pytest_cache/
sanitization-server/.coverage

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# API Keys (NEVER commit these)
**/api-keys.json
**/config.secret.json
*.key
*.pem

# IDE files
.vscode/launch.json
.vscode/settings.json
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Dependency directories
jspm_packages/

# Build outputs
build/
dist/

# Temporary folders
tmp/
temp/

# Docker
.dockerignore

# Local development
local-config.json
test-configs/
demo-data/

# Sanitization server data
sanitization-server/data/
sanitization-server/sessions/
sanitization-server/audit-logs/claude-agent-framework/
